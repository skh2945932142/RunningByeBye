<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.RunningByeBye.GlassButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/glass_button_bg</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
    </style>

    <style name="Widget.RunningByeBye.GlassButton.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/glass_button_secondary_bg</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
    </style>
</resources>
